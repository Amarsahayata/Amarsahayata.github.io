# Copy to .env on the SERVER. Never put this file in the public website.
PORT=3000
NODE_ENV=production

# AI provider (server-side only)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=REPLACE_ON_SERVER
AI_MODEL=REPLACE_WITH_YOUR_MODEL

# Only allow your own production site to call the API.
ALLOWED_ORIGIN=https://YOUR-DOMAIN.example

# Updater protection
UPDATE_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
